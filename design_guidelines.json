{
  "source_reference": "Discord design system (refero.design style faec4b0c)",
  "theme": "dark",
  "colors": {
    "page": "#0e0f2d",
    "chrome": "#23272a",
    "surface": "#2c2f33",
    "blurple": "#5865f2",
    "dark_blurple": "#3442d9",
    "hover_blurple": "#8891f2",
    "fog": "#babcd9",
    "snow": "#ffffff",
    "spring_green": "#57f287",
    "vivid_cerulean": "#00b0f4",
    "ember_orange": "#fda220",
    "ekko_red": "#de2761"
  },
  "typography": {
    "display": { "family": "Nunito", "weight": 800, "case": "uppercase", "tracking": "-0.01em", "leading": "0.86-0.95" },
    "body": { "family": "Inter", "weight": "400/500", "size": "16px", "leading": 1.5, "tracking": "0.014em" }
  },
  "radius": { "buttons": "12px", "buttons_large": "16px", "cards": "16px", "panels": "24px", "pills": "104px" },
  "layout": { "max_width": "1200px", "section_gap": "80-112px", "card_padding": "32-48px" },
  "rules": [
    "Blurple only on primary CTAs — never as a large background",
    "All headlines uppercase, no gradient text, no drop shadows on cards",
    "Body text on dark uses Fog #babcd9; pure white reserved for headlines",
    "Feature cards carry their own themed gradient background for section identity",
    "Official Telegram brand mark used for every Telegram CTA",
    "Icon set: Phosphor Icons (duotone/bold weights)"
  ],
  "icons": "@phosphor-icons/react + custom official Telegram mark (components/landing/TelegramIcon.js)"
}
